# Скопируйте в `.env` в корне репозитория для `docker compose`.
# Для GHCR имя образа: ghcr.io/<логин-GitHub-в-нижнем-регистре>/...

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=films

PGADMIN_DEFAULT_EMAIL=admin@local.test
PGADMIN_DEFAULT_PASSWORD=admin

DATABASE_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres@database:5432/films
DATABASE_USERNAME=
DATABASE_PASSWORD=

LOGGER_FORMAT=json
DEBUG=

BACKEND_IMAGE=ghcr.io/stanislavbabich/film-backend:latest
FRONTEND_IMAGE=ghcr.io/stanislavbabich/film-frontend:latest
NGINX_IMAGE=ghcr.io/stanislavbabich/film-nginx:latest
